# This root .gitignore is defense-in-depth on top of frontend/.gitignore and
# backend/.gitignore, which already cover most of what's specific to each side.
# Patterns use **/ so they apply regardless of depth (backend/, frontend/, or root).

# Dependencies / build output (frontend + backend)
**/node_modules/
**/vendor/
**/dist/
**/dist-ssr/
**/public/build/

# Env files (frontend + backend)
.env
.env.*
!.env.example

# Laravel storage
**/storage/logs/
**/storage/*.key
**/storage/pail/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude Code local/personal settings (frontend + backend)
**/.claude/settings.local.json
**/.claude/scheduled_tasks.lock

# Editor / OS
**/.vscode/*
!**/.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
